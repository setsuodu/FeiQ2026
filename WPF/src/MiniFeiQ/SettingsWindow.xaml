<Window x:Class="MiniFeiQ.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置 - FeiQ 2026"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="480" Height="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F0F2F5">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="个人资料与目录" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

        <StackPanel Grid.Row="1">
            <!-- 头像 + 用户名 -->
            <Border Background="White" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                <DockPanel>
                    <Border x:Name="AvatarPreviewBorder" Width="64" Height="64" CornerRadius="32"
                            Background="#12B7F5" DockPanel.Dock="Left" Margin="0,0,14,0" Cursor="Hand"
                            MouseLeftButtonUp="AvatarPreview_Click" ClipToBounds="True">
                        <Grid>
                            <TextBlock x:Name="AvatarLetter" Text="FQ" Foreground="White" FontWeight="Bold" FontSize="20"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image x:Name="AvatarImage" Stretch="UniformToFill" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="用户名" FontSize="12" Foreground="#666" Margin="0,0,0,4"/>
                        <TextBox x:Name="UserNameBox" Height="28" Padding="4,2" MaxLength="32"/>
                        <Button Content="更换头像..." Margin="0,8,0,0" Padding="8,3" HorizontalAlignment="Left"
                                Click="ChangeAvatar_Click" Background="#F5F5F5" BorderBrush="#DDD"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 目录 -->
            <Border Background="White" CornerRadius="8" Padding="14">
                <StackPanel>
                    <TextBlock Text="接收文件目录" FontSize="12" Foreground="#666" Margin="0,0,0,4"/>
                    <DockPanel Margin="0,0,0,10">
                        <Button Content="浏览" Width="56" DockPanel.Dock="Right" Margin="6,0,0,0"
                                Click="BrowseDownload_Click"/>
                        <TextBox x:Name="DownloadDirBox" Height="28" Padding="4,2" IsReadOnly="True"/>
                    </DockPanel>
                    <TextBlock Text="聊天记录目录（SQLite）" FontSize="12" Foreground="#666" Margin="0,0,0,4"/>
                    <DockPanel>
                        <Button Content="浏览" Width="56" DockPanel.Dock="Right" Margin="6,0,0,0"
                                Click="BrowseChatDir_Click"/>
                        <TextBox x:Name="ChatDirBox" Height="28" Padding="4,2" IsReadOnly="True"/>
                    </DockPanel>
                    <TextBlock Text="更改聊天记录目录后，下次启动使用新位置；不会自动迁移旧库。"
                               FontSize="11" Foreground="#999" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="取消" Width="72" Height="30" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"/>
            <Button Content="保存" Width="72" Height="30" IsDefault="True" Click="Save_Click"
                    Background="#12B7F5" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>
