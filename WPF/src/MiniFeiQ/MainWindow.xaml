<Window x:Class="MiniFeiQ.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FeiQ 2026"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="300" Height="620"
        MinWidth="260" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="#F0F2F5"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged">
    <Window.Resources>
        <Style x:Key="FriendItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderThickness="0" Padding="{TemplateBinding Padding}" Cursor="Hand">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E8F0FE"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D2E3FC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#12B7F5" Padding="12,14">
            <DockPanel>
                <Border Width="48" Height="48" CornerRadius="24" Background="White" DockPanel.Dock="Left" Margin="0,0,10,0">
                    <TextBlock Text="FQ" FontWeight="Bold" FontSize="16" Foreground="#12B7F5"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="SelfNameText" Text="FeiQ 2026" Foreground="White" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock x:Name="StatusText" Text="未连接" Foreground="#E0F7FF" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="White" BorderBrush="#E5E5E5" BorderThickness="0,0,0,1" Padding="8,6">
            <StackPanel>
                <DockPanel Margin="0,0,0,4">
                    <ComboBox x:Name="ModeBox" Width="130" SelectedIndex="0" SelectionChanged="ModeBox_Changed"
                              DockPanel.Dock="Left" VerticalAlignment="Center">
                        <ComboBoxItem Content="UDP 局域网"/>
                        <ComboBoxItem Content="WebSocket 中继"/>
                    </ComboBox>
                    <Button x:Name="ConnectBtn" Content="连接" Width="56" Margin="6,0,0,0"
                            Click="Connect_Click" DockPanel.Dock="Right"/>
                    <TextBox x:Name="ServerUrlBox" Text="ws://192.168.1.101:9000/ws"
                             Margin="6,0,0,0" VerticalContentAlignment="Center"
                             ToolTip="中继地址，仅 WebSocket 模式需要"/>
                </DockPanel>
                <TextBox x:Name="SearchBox" Padding="6,4" ToolTip="搜索好友"
                         TextChanged="SearchBox_TextChanged" Background="#F5F5F5" BorderBrush="#E0E0E0"/>
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="2" Background="White">
            <DockPanel DockPanel.Dock="Top" Margin="10,8,10,4">
                <TextBlock Text="我的好友" FontWeight="SemiBold" FontSize="13" Foreground="#333"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="OnlineCountText" Text="(0)" Foreground="#888" FontSize="12"
                           Margin="4,0,0,0" VerticalAlignment="Center"/>
                <Button Content="刷新" Padding="8,2" HorizontalAlignment="Right" DockPanel.Dock="Right"
                        Click="Refresh_Click" Background="Transparent" BorderThickness="0" Cursor="Hand"
                        Foreground="#12B7F5"/>
            </DockPanel>
            <ListBox x:Name="UserList"
                     BorderThickness="0"
                     Background="Transparent"
                     ItemContainerStyle="{StaticResource FriendItem}"
                     MouseDoubleClick="UserList_MouseDoubleClick"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <Border Width="40" Height="40" CornerRadius="20" Background="#12B7F5"
                                    DockPanel.Dock="Left" Margin="0,0,10,0">
                                <TextBlock Text="{Binding AvatarLetter}" Foreground="White" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="#222"/>
                                <TextBlock Text="{Binding SubTitle}" FontSize="11" Foreground="#888" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <Border Grid.Row="3" Background="#FAFAFA" BorderBrush="#E5E5E5" BorderThickness="0,1,0,0" Padding="10,8">
            <TextBlock Text="双击好友打开聊天 · 关闭窗口将最小化到托盘"
                       FontSize="11" Foreground="#999" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>
