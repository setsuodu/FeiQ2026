<Window x:Class="MiniFeiQ.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MiniFeiQ (文件传输版)" Icon="pack://application:,,,/Assets/app.ico" Width="720" Height="520"
        Closing="Window_Closing">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部：传输模式切换 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="传输模式：" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="ModeBox" Width="160" SelectedIndex="0" SelectionChanged="ModeBox_Changed">
                <ComboBoxItem Content="UDP 局域网 (飞秋兼容)"/>
                <ComboBoxItem Content="WebSocket 中继"/>
            </ComboBox>
            <TextBlock Text="  中继地址：" VerticalAlignment="Center" Margin="12,0,4,0"/>
            <TextBox x:Name="ServerUrlBox" Width="240" Text="ws://192.168.1.101:9000/ws" VerticalAlignment="Center"/>
            <Button x:Name="ConnectBtn" Content="连接/重连" Width="80" Margin="8,0,0,0" Click="Connect_Click"/>
            <TextBlock x:Name="StatusText" Text="  未连接" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="Gray"/>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock DockPanel.Dock="Top" Text="在线用户" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <Button DockPanel.Dock="Bottom" Content="刷新" Click="Refresh_Click" Margin="0,6,0,0"/>
                <ListBox x:Name="UserList" DisplayMemberPath="."/>
            </DockPanel>

            <DockPanel Grid.Column="1">
                <TextBlock DockPanel.Dock="Top" Text="聊天记录" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                    <Button DockPanel.Dock="Right" Content="发送" Width="60" Margin="4,0,0,0" Click="Send_Click" IsDefault="True"/>
                    <Button DockPanel.Dock="Right" Content="发文件" Width="60" Click="SendFile_Click"/>
                    <TextBox x:Name="Input" Margin="0,0,4,0"/>
                </DockPanel>
                <TextBox x:Name="Log" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                         TextWrapping="Wrap" AcceptsReturn="True"/>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
