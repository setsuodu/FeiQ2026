<Window x:Class="FeiQ2026.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="聊天"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="520" Height="560"
        MinWidth="400" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        AllowDrop="True"
        PreviewDragOver="Window_PreviewDragOver"
        PreviewDragLeave="Window_PreviewDragLeave"
        Drop="Window_Drop"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏信息 -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E5E5E5" BorderThickness="0,0,0,1" Padding="14,10">
            <DockPanel>
                <Border Width="36" Height="36" CornerRadius="18" Background="#12B7F5" DockPanel.Dock="Left" Margin="0,0,10,0">
                    <TextBlock x:Name="AvatarText" Text="?" Foreground="White" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Button Content="⋮" Width="32" Height="28" FontSize="16" Padding="0"
                        DockPanel.Dock="Right" VerticalAlignment="Center"
                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                        Click="Menu_Click" ToolTip="更多">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="TitleMenu">
                            <MenuItem Header="清空聊天记录" Click="ClearHistory_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="PeerNameText" Text="好友" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock x:Name="PeerIpText" Text="" FontSize="11" Foreground="#888"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 消息区（可拖入文件） -->
        <Border Grid.Row="1" Background="#EDEDED" Padding="8">
            <Grid>
            <ScrollViewer x:Name="MsgScroll" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="MsgList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <!-- 系统消息：居中，无头像 -->
                                <Border HorizontalAlignment="Center"
                                        Visibility="{Binding SystemVisibility}"
                                        Background="#E0E0E0" CornerRadius="6" Padding="10,5" MaxWidth="360">
                                    <TextBlock Text="{Binding Text}" FontSize="12" Foreground="#666" TextWrapping="Wrap"
                                               TextAlignment="Center"/>
                                </Border>

                                <!-- 普通/富媒体消息：三列布局 左头像 | 气泡 | 右头像 -->
                                <Grid Visibility="{Binding RowVisibility}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 对方头像（左列） -->
                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18"
                                            Background="{Binding PeerAvatarBg}"
                                            Margin="0,0,8,0" VerticalAlignment="Top" ClipToBounds="True"
                                            Visibility="{Binding PeerAvatarVisibility}">
                                        <Grid>
                                            <TextBlock Text="{Binding PeerAvatarLetter}" Foreground="White"
                                                       FontWeight="Bold" FontSize="14"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding PeerAvatarLetterVisibility}"/>
                                            <Image Source="{Binding PeerAvatarImage}" Stretch="UniformToFill"
                                                   Visibility="{Binding PeerAvatarImageVisibility}"/>
                                        </Grid>
                                    </Border>

                                    <!-- 气泡（中列，按 Align 左右对齐） -->
                                    <Border Grid.Column="1" Padding="10,7" CornerRadius="6" MaxWidth="320"
                                            HorizontalAlignment="{Binding Align}"
                                            Background="{Binding BubbleBrush}">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="复制"
                                                          Click="CopyBubble_Click"
                                                          Visibility="{Binding TextVisibility}"/>
                                                <MenuItem Header="打开所在位置"
                                                          Click="OpenFolder_Click"
                                                          Visibility="{Binding OpenFolderVisibility}"/>
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <StackPanel>
                                            <Border Visibility="{Binding ImageVisibility}" Margin="0,0,0,4"
                                                    CornerRadius="4" ClipToBounds="True" MaxWidth="240" MaxHeight="180"
                                                    Cursor="Hand" MouseLeftButtonUp="Media_Click">
                                                <Image Source="{Binding ImageSource}" Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Border>
                                            <Border Visibility="{Binding FileCardVisibility}"
                                                    Background="#F8F8F8" BorderBrush="#E0E0E0" BorderThickness="1"
                                                    CornerRadius="6" Padding="10,8" Margin="0,0,0,4"
                                                    Cursor="Hand" MouseLeftButtonUp="Media_Click">
                                                <DockPanel>
                                                    <TextBlock Text="{Binding TypeIcon}" FontSize="28"
                                                               VerticalAlignment="Center" Margin="0,0,10,0"
                                                               DockPanel.Dock="Left"/>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FileName}" FontSize="13" FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                                                        <TextBlock Text="{Binding TypeLabel}" FontSize="11" Foreground="#888"
                                                                   Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                            <!-- 纯文本（无表情图）：用只读 TextBox 支持选中/复制，双击全选 -->
                                            <TextBox Text="{Binding Text}" TextWrapping="Wrap" FontSize="13"
                                                     Foreground="{Binding TextBrush}"
                                                     Visibility="{Binding PlainTextVisibility}"
                                                     Cursor="{Binding TextCursor}"
                                                     IsReadOnly="True"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     Padding="0"
                                                     Margin="0"
                                                     IsTabStop="False"
                                                     AcceptsReturn="True"
                                                     VerticalScrollBarVisibility="Disabled"
                                                     HorizontalScrollBarVisibility="Disabled"
                                                     Focusable="True"
                                                     PreviewMouseLeftButtonUp="Url_Click"
                                                     MouseDoubleClick="BubbleText_DoubleClick"/>
                                            <!-- 混排：文字 + 表情图片（可右键复制整段） -->
                                            <ItemsControl ItemsSource="{Binding Segments}"
                                                          Visibility="{Binding RichTextVisibility}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <TextBox Text="{Binding Text}" FontSize="13"
                                                                     Foreground="{Binding DataContext.TextBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                     VerticalAlignment="Center"
                                                                     Visibility="{Binding TextVisibility}"
                                                                     IsReadOnly="True"
                                                                     BorderThickness="0"
                                                                     Background="Transparent"
                                                                     Padding="0"
                                                                     Margin="0"
                                                                     IsTabStop="False"
                                                                     Focusable="True"
                                                                     MouseDoubleClick="BubbleText_DoubleClick"/>
                                                            <Image Source="{Binding Image}" Width="22" Height="22"
                                                                   Margin="1,0" VerticalAlignment="Center"
                                                                   Visibility="{Binding ImageVisibility}"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{Binding Time}" FontSize="10" Foreground="#999"
                                                       HorizontalAlignment="Right" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 自己头像（右列） -->
                                    <Border Grid.Column="2" Width="36" Height="36" CornerRadius="18"
                                            Background="{Binding SelfAvatarBg}"
                                            Margin="8,0,0,0" VerticalAlignment="Top" ClipToBounds="True"
                                            Visibility="{Binding SelfAvatarVisibility}">
                                        <Grid>
                                            <Image Source="{Binding SelfAvatarImage}" Stretch="UniformToFill"
                                                   Visibility="{Binding SelfAvatarImageVisibility}"/>
                                            <TextBlock Text="{Binding SelfAvatarLetter}" Foreground="White"
                                                       FontWeight="Bold" FontSize="14"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding SelfAvatarLetterVisibility}"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <!-- 拖拽提示遮罩 -->
            <Border x:Name="DropOverlay" Background="#9912B7F5" Visibility="Collapsed"
                    IsHitTestVisible="False" CornerRadius="4" Margin="4">
                <TextBlock Text="松开以发送文件" Foreground="White" FontSize="18" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            </Grid>
        </Border>

        <!-- 工具条 -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E5E5E5" BorderThickness="0,1,0,0" Padding="8,4">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="EmojiBtn" Content="😀" Width="36" Height="28" FontSize="16" Padding="0"
                        Click="Emoji_Click" Margin="0,0,6,0"
                        Background="#F0F0F0" BorderBrush="#DDD" Cursor="Hand" ToolTip="表情"/>
                <Button Content="发送文件" Padding="10,4" Click="SendFile_Click" Margin="0,0,6,0"
                        Background="#F0F0F0" BorderBrush="#DDD" Cursor="Hand" ToolTip="选择文件发送，也可直接拖拽到聊天窗口"/>
            </StackPanel>
        </Border>

        <!-- 输入区：Enter 发送，Shift+Enter 换行 -->
        <Border Grid.Row="3" Background="White" Padding="8">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="发送" Width="72" Height="32" Margin="8,0,0,0"
                        Click="Send_Click"
                        Background="#12B7F5" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>
                <TextBox x:Name="Input" AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="56" MaxHeight="120" VerticalScrollBarVisibility="Auto"
                         BorderBrush="#DDD" Padding="6"
                         PreviewKeyDown="Input_PreviewKeyDown"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
