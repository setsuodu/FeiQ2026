<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>FeiQ2026</AssemblyName>
    <RootNamespace>FeiQ2026</RootNamespace>
    <Product>FeiQ 2026</Product>
    <AssemblyTitle>FeiQ 2026</AssemblyTitle>
    <Description>FeiQ 2026 - 兼容飞秋2013的局域网/中继即时通讯</Description>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Text.Encoding.CodePages" Version="10.0.12" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <!-- 表情素材：复制到输出目录，运行时从磁盘加载（不嵌入，方便用户自己换图） -->
    <Content Include="Assets\Emoji\**\*.*" CopyToOutputDirectory="PreserveNewest" Link="Assets\Emoji\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
