<Window x:Class="FeiQ2026.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置 - FeiQ 2026"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="500" Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F0F2F5">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="个人资料与目录" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 头像 + 用户名 -->
                <Border Background="White" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                    <DockPanel>
                        <Border x:Name="AvatarPreviewBorder" Width="64" Height="64" CornerRadius="32"
                                Background="#12B7F5" DockPanel.Dock="Left" Margin="0,0,14,0" Cursor="Hand"
                                MouseLeftButtonUp="AvatarPreview_Click" ClipToBounds="True">
                            <Grid>
                                <TextBlock x:Name="AvatarLetter" Text="FQ" Foreground="White" FontWeight="Bold" FontSize="20"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image x:Name="AvatarImage" Stretch="UniformToFill" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="用户名" FontSize="12" Foreground="#666" Margin="0,0,0,4"/>
                            <TextBox x:Name="UserNameBox" Height="28" Padding="4,2" MaxLength="32"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="更换头像..." Padding="8,3" Margin="0,0,8,0"
                                        Click="ChangeAvatar_Click" Background="#F5F5F5" BorderBrush="#DDD"/>
                                <Button Content="清除头像" Padding="8,3"
                                        Click="ClearAvatar_Click" Background="#F5F5F5" BorderBrush="#DDD"
                                        ToolTip="恢复为默认字母头像"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- 中继地址 -->
                <Border Background="White" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="WebSocket 中继地址" FontSize="12" Foreground="#666" Margin="0,0,0,4"/>
                        <TextBox x:Name="ServerUrlBox" Height="28" Padding="4,2"
                                 ToolTip="例如 wss://s0.v100.vip:27658/ws"/>
                        <TextBlock Text="仅在主界面选择「WebSocket 中继」时使用。修改后保存会自动重连。"
                                   FontSize="11" Foreground="#999" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 目录 -->
                <Border Background="White" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="接收文件目录" FontSize="12" Foreground="#666" Margin="0,0,0,4"/>
                        <DockPanel Margin="0,0,0,10">
                            <Button Content="浏览" Width="56" DockPanel.Dock="Right" Margin="6,0,0,0"
                                    Click="BrowseDownload_Click"/>
                            <TextBox x:Name="DownloadDirBox" Height="28" Padding="4,2" IsReadOnly="True"/>
                        </DockPanel>
                        <TextBlock Text="聊天记录目录（SQLite）" FontSize="12" Foreground="#666" Margin="0,0,0,4"/>
                        <DockPanel>
                            <Button Content="浏览" Width="56" DockPanel.Dock="Right" Margin="6,0,0,0"
                                    Click="BrowseChatDir_Click"/>
                            <TextBox x:Name="ChatDirBox" Height="28" Padding="4,2" IsReadOnly="True"/>
                        </DockPanel>
                        <TextBlock Text="更改聊天记录目录后，下次启动使用新位置；不会自动迁移旧库。"
                                   FontSize="11" Foreground="#999" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 软件更新 (Velopack) -->
                <Border Background="White" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="软件更新" FontSize="12" Foreground="#666" Margin="0,0,0,8"/>
                        <DockPanel>
                            <Button x:Name="CheckUpdateBtn" Content="检查更新" Width="88" Height="28"
                                    DockPanel.Dock="Right" Click="CheckUpdate_Click"
                                    Background="#12B7F5" Foreground="White" BorderThickness="0"/>
                            <TextBlock x:Name="UpdateStatusText" Text="点击检查是否有新版本"
                                       FontSize="12" Foreground="#666" VerticalAlignment="Center"
                                       TextWrapping="Wrap" Margin="0,0,10,0"/>
                        </DockPanel>
                        <TextBlock Text="更新源：GitHub Releases（需使用 Velopack 安装包安装后才可自动更新）。"
                                   FontSize="11" Foreground="#999" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 开机启动 -->
                <Border Background="White" CornerRadius="8" Padding="14">
                    <StackPanel>
                        <CheckBox x:Name="StartWithWindowsCheck" Content="开机自动启动"
                                  FontSize="13" VerticalContentAlignment="Center"/>
                        <TextBlock Text="勾选后将写入当前用户启动项（注册表 Run），取消勾选会移除。"
                                   FontSize="11" Foreground="#999" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <Button Content="取消" Width="72" Height="30" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"/>
                <Button Content="保存" Width="72" Height="30" IsDefault="True" Click="Save_Click"
                        Background="#12B7F5" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>
            </StackPanel>
            <TextBlock x:Name="VersionText" Text="版本 —" FontSize="11" Foreground="#999"
                       VerticalAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>
    </Grid>
</Window>
