<Window x:Class="MiniFeiQ.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MiniFeiQ" Width="600" Height="420">
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <DockPanel Grid.Column="0" Margin="0,0,8,0">
            <Button DockPanel.Dock="Bottom" Content="刷新在线用户" Click="Refresh_Click" Margin="0,6,0,0"/>
            <ListBox x:Name="UserList"/>
        </DockPanel>
        <DockPanel Grid.Column="1">
            <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                <Button DockPanel.Dock="Right" Content="发送" Width="70" Click="Send_Click"/>
                <TextBox x:Name="Input" Margin="0,0,6,0"/>
            </DockPanel>
            <TextBox x:Name="Log" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
        </DockPanel>
    </Grid>
</Window>
